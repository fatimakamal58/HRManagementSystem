@model HRManagementSystem.Infrastructure.Identity.DTOs.CreateUserDto

@{
    ViewData["Title"] = "إنشاء حساب مستخدم";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">إنشاء حساب مستخدم</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label">
                                البريد الإلكتروني
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   autocomplete="off" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label">
                                كلمة المرور
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                تأكيد كلمة المرور
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role"
                                   class="form-label">
                                الصلاحية
                            </label>

                            <select asp-for="Role"
                                    class="form-select">
                                <option value="">
                                    -- اختر الصلاحية --
                                </option>

                                <option value="Employee">Employee</option>
                                <option value="HR">HR</option>
                                <option value="HRManager">HR Manager</option>
                                <option value="Admin">Admin</option>
                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit"
                                    class="btn btn-primary">
                                إنشاء الحساب
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}