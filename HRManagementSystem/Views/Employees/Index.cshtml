@model IEnumerable<EmployeeDto>

@{
    ViewData["Title"] = "الموظفون";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>الموظفون</h1>

    <a asp-action="Create" class="btn btn-primary">
        إضافة موظف
    </a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>رقم الموظف</th>
                <th>الاسم</th>
                <th>رقم الهوية</th>
                <th>القسم</th>
                <th>المسمى الوظيفي</th>
                <th>رقم الهاتف</th>
                <th>الحالة</th>
                <th>الإجراءات</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.EmployeeNumber</td>
                    <td>@employee.FullNameAr</td>
                    <td>@employee.NationalId</td>
                    <td>@employee.DepartmentName</td>
                    <td>@employee.JobTitleName</td>
                    <td>@employee.PhoneNumber</td>
                    <td>@employee.EmploymentStatus</td>


                    

                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit"
                               asp-route-id="@employee.Id"
                               class="btn btn-sm btn-outline-primary">
                                تعديل
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@employee.Id"
                               class="btn btn-sm btn-outline-info">
                                التفاصيل
                            </a>

                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteEmployeeModal"
                                    data-id="@employee.Id"
                                    data-name="@employee.FullNameAr">
                                حذف
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="modal fade"
         id="deleteEmployeeModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">تأكيد الحذف</h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    هل أنت متأكد من حذف الموظف
                    <strong id="employeeName"></strong>؟
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        إلغاء
                    </button>

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               id="deleteEmployeeId"
                               name="id" />

                        <button type="submit"
                                class="btn btn-danger">
                            حذف
                        </button>

                    </form>

                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const deleteModal =
            document.getElementById('deleteEmployeeModal');

        deleteModal.addEventListener(
            'show.bs.modal',
            function (event) {

                const button = event.relatedTarget;

                const employeeId =
                    button.getAttribute('data-id');

                const employeeName =
                    button.getAttribute('data-name');

                document.getElementById(
                    'deleteEmployeeId'
                ).value = employeeId;

                document.getElementById(
                    'employeeName'
                ).textContent = employeeName;
            });
    </script>
}