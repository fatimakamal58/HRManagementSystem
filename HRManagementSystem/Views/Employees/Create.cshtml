@model CreateEmployeeViewModel

<h1>إضافة موظف</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="row">

        <div class="col-md-6 mb-3">
            <label asp-for="Employee.NationalId"
                   class="form-label">رقم الهوية أو الإقامة</label>
            <input asp-for="Employee.NationalId"
                   class="form-control" />
            <span asp-validation-for="Employee.NationalId"
                  class="text-danger"></span>
        </div>
    </div>

    <h5 class="mt-3">الاسم بالعربية</h5>

    <div class="row">
        <div class="col-md-3 mb-3">
            <label asp-for="Employee.FirstNameAr" class="form-label">الاسم الأول</label>
            <input asp-for="Employee.FirstNameAr" class="form-control" />
            <span asp-validation-for="Employee.FirstNameAr" class="text-danger"></span>
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Employee.SecondNameAr" class="form-label">الاسم الثاني</label>
            <input asp-for="Employee.SecondNameAr" class="form-control" />
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Employee.ThirdNameAr" class="form-label">الاسم الثالث</label>
            <input asp-for="Employee.ThirdNameAr" class="form-control" />
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Employee.LastNameAr" class="form-label">اسم العائلة</label>
            <input asp-for="Employee.LastNameAr" class="form-control" />
            <span asp-validation-for="Employee.LastNameAr" class="text-danger"></span>
        </div>
    </div>

    <h5 class="mt-3">الاسم بالإنجليزية</h5>

    <div class="row" dir="ltr">
        <div class="col-md-3 mb-3">
            <label asp-for="Employee.FirstNameEn" class="form-label">First Name</label>
            <input asp-for="Employee.FirstNameEn" class="form-control" />
            <span asp-validation-for="Employee.FirstNameEn" class="text-danger"></span>
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Employee.SecondNameEn" class="form-label">Second Name</label>
            <input asp-for="Employee.SecondNameEn" class="form-control" />
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Employee.ThirdNameEn" class="form-label">Third Name</label>
            <input asp-for="Employee.ThirdNameEn" class="form-control" />
        </div>

        <div class="col-md-3 mb-3">
            <label asp-for="Employee.LastNameEn" class="form-label">Last Name</label>
            <input asp-for="Employee.LastNameEn" class="form-control" />
            <span asp-validation-for="Employee.LastNameEn" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Employee.Gender" class="form-label">الجنس</label>
            <select asp-for="Employee.Gender"
                    asp-items="Html.GetEnumSelectList<HRManagementSystem.Domain.Enums.Gender>()"
                    class="form-select">
                <option value="">اختر الجنس</option>
            </select>
            <span asp-validation-for="Employee.Gender" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Employee.BirthDate" class="form-label">تاريخ الميلاد</label>
            <input asp-for="Employee.BirthDate" class="form-control" />
            <span asp-validation-for="Employee.BirthDate" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Employee.HireDate" class="form-label">تاريخ التوظيف</label>
            <input asp-for="Employee.HireDate" class="form-control" />
            <span asp-validation-for="Employee.HireDate" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Employee.DepartmentId" class="form-label">القسم</label>
            <select asp-for="Employee.DepartmentId"
                    asp-items="Model.Departments"
                    class="form-select">
                <option value="">اختر القسم</option>
            </select>
            <span asp-validation-for="Employee.DepartmentId" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Employee.JobTitleId" class="form-label">المسمى الوظيفي</label>
            <select asp-for="Employee.JobTitleId"
                    asp-items="Model.JobTitles"
                    class="form-select">
                <option value="">اختر المسمى الوظيفي</option>
            </select>
            <span asp-validation-for="Employee.JobTitleId" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Employee.PhoneNumber" class="form-label">رقم الهاتف</label>
            <input asp-for="Employee.PhoneNumber" class="form-control" />
            <span asp-validation-for="Employee.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Employee.Email" class="form-label">البريد الإلكتروني</label>
            <input asp-for="Employee.Email" class="form-control" />
            <span asp-validation-for="Employee.Email" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Employee.EmploymentStatus"
                   class="form-label">حالة الموظف</label>

            <select asp-for="Employee.EmploymentStatus"
                    asp-items="Html.GetEnumSelectList<HRManagementSystem.Domain.Enums.EmploymentStatus>()"
                    class="form-select">
                <option value="">اختر الحالة</option>
            </select>

            <span asp-validation-for="Employee.EmploymentStatus"
                  class="text-danger"></span>
        </div>

       
    </div>

    <button type="submit" class="btn btn-primary">
        حفظ
    </button>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        إلغاء
    </a>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}