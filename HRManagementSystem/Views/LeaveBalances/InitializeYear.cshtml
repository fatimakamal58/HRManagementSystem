@model InitializeLeaveBalanceDto

@{
    ViewData["Title"] = "تهيئة أرصدة الإجازات";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h4 class="mb-0">
                        تهيئة أرصدة الإجازات لسنة @Model.Year
                    </h4>
                </div>

                <div class="card-body">

                    <p class="text-muted">
                        راجع عدد الأيام لكل نوع إجازة قبل إنشاء
                        أرصدة الموظفين. يمكنك تعديل العدد لهذه السنة
                        دون تغيير الرصيد الافتراضي لنوع الإجازة.
                    </p>

                    <form asp-action="InitializeYear"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <input asp-for="Year" type="hidden" />

                        @if (Model.LeaveTypes.Count == 0)
                        {
                            <div class="alert alert-warning">
                                لا توجد أنواع إجازات تحتاج إلى رصيد.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">

                                <table class="table table-bordered align-middle">

                                    <thead>
                                        <tr>
                                            <th>نوع الإجازة</th>
                                            <th style="width: 200px;">
                                                عدد الأيام
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @for (var i = 0;
                                              i < Model.LeaveTypes.Count;
                                              i++)
                                        {
                                            <tr>
                                                <td>
                                                    @Model.LeaveTypes[i].LeaveTypeName

                                                    <input asp-for="LeaveTypes[i].LeaveTypeId"
                                                           type="hidden" />

                                                    <input asp-for="LeaveTypes[i].LeaveTypeName"
                                                           type="hidden" />
                                                </td>

                                                <td>
                                                    <input asp-for="LeaveTypes[i].Days"
                                                           class="form-control"
                                                           type="number"
                                                           min="0"
                                                           step="0.5" />

                                                    <span asp-validation-for="LeaveTypes[i].Days"
                                                          class="text-danger"></span>
                                                </td>
                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                            <div class="alert alert-info">
                                الأرصدة الموجودة مسبقًا لهذه السنة
                                لن يتم تعديلها. سيتم إنشاء الأرصدة
                                المفقودة فقط.
                            </div>

                            <div class="d-flex justify-content-between">

                                <a asp-action="Index"
                                   class="btn btn-secondary">
                                    رجوع
                                </a>

                                <button type="submit"
                                        class="btn btn-primary">
                                    تهيئة الأرصدة
                                </button>

                            </div>
                        }

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}