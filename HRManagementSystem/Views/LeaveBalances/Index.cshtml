@model List<LeaveBalanceDto>

@{
    ViewData["Title"] = "أرصدة الإجازات";
    var currentYear = DateTime.Today.Year;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3>أرصدة الإجازات</h3>
            <p class="text-muted mb-0">
                إدارة ومتابعة أرصدة إجازات الموظفين.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="card-title">
                تهيئة أرصدة سنة
            </h5>

            <p class="text-muted">
                سيتم إنشاء الأرصدة المفقودة اعتمادًا على الرصيد
                الافتراضي لكل نوع إجازة، ولن يتم تعديل الأرصدة
                الموجودة مسبقًا.
            </p>

            <form asp-action="InitializeYear"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label for="year"
                           class="form-label">
                        السنة
                    </label>

                    <input type="number"
                           id="year"
                           name="year"
                           value="@currentYear"
                           min="2000"
                           max="2100"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-auto">
                    <button type="submit"
                            class="btn btn-primary">
                        تهيئة أرصدة السنة
                    </button>
                </div>

            </form>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    لا توجد أرصدة إجازات حتى الآن.
                    قم بتهيئة أرصدة السنة أولًا.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped align-middle mb-0">

                        <thead>
                            <tr>
                                <th>الموظف</th>
                                <th>نوع الإجازة</th>
                                <th>السنة</th>
                                <th>المخصص</th>
                                <th>المرحّل</th>
                                <th>الإجمالي</th>
                                <th>المستخدم</th>
                                <th>المحجوز</th>
                                <th>المتبقي</th>
                                <th>المتاح</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.EmployeeName</td>

                                    <td>@item.LeaveTypeName</td>

                                    <td>@item.Year</td>

                                    <td>@item.AllocatedDays</td>

                                    <td>@item.CarryForwardDays</td>

                                    <td>@item.TotalDays</td>

                                    <td>@item.UsedDays</td>

                                    <td>@item.ReservedDays</td>

                                    <td>@item.RemainingDays</td>

                                    <td>
                                        <strong>
                                            @item.AvailableDays
                                        </strong>
                                    </td>
                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            تعديل
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>