@model HRManagementSystem.Application.DTOs.LeaveTypes.CreateLeaveTypeDto

@{
    ViewData["Title"] = "إضافة نوع إجازة";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h4 class="mb-0">إضافة نوع إجازة</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="NameAr" class="form-label">
                                الاسم بالعربي
                            </label>
                            <input asp-for="NameAr" class="form-control" />
                            <span asp-validation-for="NameAr"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NameEn" class="form-label">
                                الاسم بالإنجليزي
                            </label>
                            <input asp-for="NameEn" class="form-control" />
                            <span asp-validation-for="NameEn"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="RequiresBalance"
                                   class="form-check-input" />
                            <label asp-for="RequiresBalance"
                                   class="form-check-label">
                                يتطلب رصيد
                            </label>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DefaultDaysPerYear"
                                   class="form-label">
                                عدد الأيام الافتراضي سنويًا
                            </label>
                            <input asp-for="DefaultDaysPerYear"
                                   class="form-control" />
                        </div>

                        <hr />

                        <div class="form-check mb-3">
                            <input asp-for="IncludeNonWorkingDays"
                                   class="form-check-input" />
                            <label asp-for="IncludeNonWorkingDays"
                                   class="form-check-label">
                                احتساب أيام عدم العمل ضمن الإجازة
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="IncludePublicHolidays"
                                   class="form-check-input" />
                            <label asp-for="IncludePublicHolidays"
                                   class="form-check-label">
                                احتساب العطلات الرسمية ضمن الإجازة
                            </label>
                        </div>

                        <hr />

                        <div class="form-check mb-3">
                            <input asp-for="AllowCarryForward"
                                   class="form-check-input" />
                            <label asp-for="AllowCarryForward"
                                   class="form-check-label">
                                السماح بترحيل الرصيد
                            </label>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaxCarryForwardDays"
                                   class="form-label">
                                الحد الأقصى للأيام المرحّلة
                            </label>
                            <input asp-for="MaxCarryForwardDays"
                                   class="form-control" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index"
                               class="btn btn-secondary">
                                رجوع
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                حفظ
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}