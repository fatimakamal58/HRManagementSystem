@model CreateLeaveRequestViewModel

@{
    ViewData["Title"] = "طلب إجازة جديد";
    var currentYear = DateTime.Today.Year;
    var currentBalances = Model.Balances
        .Where(x => x.Year == currentYear)
        .ToList();
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="mb-1">طلب إجازة جديد</h2>
        <p class="text-muted mb-0">
            يمكنك مراجعة رصيدك ثم تقديم طلب إجازة جديد.
        </p>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <strong>أرصدة الإجازات - @currentYear</strong>
        </div>

        <div class="card-body">

            @if (currentBalances.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    لا توجد أرصدة إجازات مسجلة لك لهذه السنة.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>نوع الإجازة</th>
                                <th>الإجمالي</th>
                                <th>المستخدم</th>
                                <th>المحجوز</th>
                                <th>المتاح</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var balance in currentBalances)
                            {
                                <tr>
                                    <td>@balance.LeaveTypeName</td>
                                    <td>@balance.TotalDays</td>
                                    <td>@balance.UsedDays</td>
                                    <td>@balance.ReservedDays</td>
                                    <td>
                                        <strong>@balance.AvailableDays</strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <strong>بيانات طلب الإجازة</strong>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Request.LeaveTypeId"
                           class="form-label">
                        نوع الإجازة
                    </label>

                    <select asp-for="Request.LeaveTypeId"
                            asp-items="Model.LeaveTypes"
                            class="form-select">

                        <option value="">
                            -- اختر نوع الإجازة --
                        </option>

                    </select>

                    <span asp-validation-for="Request.LeaveTypeId"
                          class="text-danger">
                    </span>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Request.StartDate"
                               class="form-label">
                            تاريخ البداية
                        </label>

                        <input asp-for="Request.StartDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Request.StartDate"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Request.EndDate"
                               class="form-label">
                            تاريخ النهاية
                        </label>

                        <input asp-for="Request.EndDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Request.EndDate"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Request.Reason"
                           class="form-label">
                        السبب
                    </label>

                    <textarea asp-for="Request.Reason"
                              class="form-control"
                              rows="4"
                              placeholder="اكتب سبب الإجازة - اختياري">
                    </textarea>

                    <span asp-validation-for="Request.Reason"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        تقديم الطلب
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        رجوع
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}