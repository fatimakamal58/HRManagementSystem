@model EmployeeSalaryHistoryViewModel

@{
    ViewData["Title"] = "Salary History";
}

<h2>Salary History</h2>

<div>
    <strong>Employee:</strong>
    @Model.EmployeeName
</div>

<div>
    <strong>Employee Number:</strong>
    @Model.EmployeeNumber
</div>
@if (!Model.IsEmployeeActive)
{
    <div class="alert alert-secondary mt-3">
        This employee is inactive. Salary history is read-only.
    </div>
}
else if (!Model.Salaries.Any())
{
    <div class="alert alert-info mt-3">
        No salary has been registered for this employee.
    </div>

    <a asp-action="Create"
       asp-route-employeeId="@Model.EmployeeId"
       class="btn btn-primary">
        Add Initial Salary
    </a>
}
else
{
    <div class="mt-3 mb-3">
        <a asp-action="Change"
           asp-route-employeeId="@Model.EmployeeId"
           class="btn btn-primary">
            Change Salary
        </a>
    </div>
}
@if (Model.Salaries.Any())
{
    <table class="table table-bordered">
        <thead>
        <tr>
            <th>Basic Salary</th>
            <th>Effective From</th>
            <th>Effective To</th>
            <th>Reason</th>
            <th>Notes</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var salary in Model.Salaries)
        {
            <tr>
                <td>@salary.BasicSalary.ToString("N2")</td>

                <td>
                    @salary.EffectiveFrom.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @(salary.EffectiveTo.HasValue
                        ? salary.EffectiveTo.Value.ToString("dd/MM/yyyy")
                        : "-")
                </td>

                <td>@salary.ChangeReason</td>

                <td>@(salary.Notes ?? "-")</td>
            </tr>
        }
        </tbody>
    </table>
}